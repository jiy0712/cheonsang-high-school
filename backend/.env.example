# ===== 천상고 백엔드 환경 변수 예시 =====
# 이 파일을 backend/.env 로 복사해서 사용하세요.
#   cp backend/.env.example backend/.env

# 서버 포트 (프론트엔드가 /api 를 이 포트로 프록시합니다)
BACKEND_PORT=3001

# ---------------------------------------------------------------
# 데이터베이스 선택
# ---------------------------------------------------------------
# [A] 로컬 Docker PostgreSQL 사용 (권장, docker-compose up -d 후):
EMBEDDED_DB=false
DATABASE_URL=postgres://cheonsang:cheonsang@localhost:5432/cheonsang
#
# [B] PostgreSQL 없이 임베디드 DB(PGlite)로 바로 실행 (v0 미리보기 방식):
# EMBEDDED_DB=true
#   → 이 경우 DATABASE_URL 은 자동 설정되므로 지정하지 않아도 됩니다.
# ---------------------------------------------------------------

# 부팅 시 초기 데이터 자동 시딩 (이미 있으면 건너뜀)
AUTO_SEED=true

# 개발 환경에서 스키마 자동 동기화 (운영 환경에서는 false 권장)
DB_SYNCHRONIZE=true

# JWT 서명 비밀키 (운영 환경에서는 반드시 안전한 랜덤 값으로 교체)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# 초기 관리자 계정 (seed 실행 시 생성)
ADMIN_EMAIL=admin@cheonsang.hs.kr
ADMIN_PASSWORD=admin1234!
ADMIN_NAME=관리자

# ---------------------------------------------------------------
# 급식 데이터 (NEIS 나이스 교육정보 개방 API)
# ---------------------------------------------------------------
# 홈 화면 "오늘의 급식"은 천상고등학교 실제 급식을 NEIS 에서 실시간으로 가져옵니다.
# 아래 학교 코드는 천상고등학교(울산) 기본값이라 그대로 두면 됩니다.
NEIS_ATPT_OFCDC_CODE=H10      # 시도교육청 코드 (울산광역시교육청)
NEIS_SCHUL_CODE=7480209       # 표준학교 코드 (천상고등학교)
#
# NEIS 인증키. 없어도 소량 조회는 가능하지만, 안정적인 사용을 위해
# https://open.neis.go.kr 에서 무료 발급 후 아래에 넣는 것을 권장합니다.
# NEIS_API_KEY=발급받은_인증키

# ---------------------------------------------------------------
# 공지사항·가정통신문·학교앨범 (학교 공식 홈페이지 실시간 스크래핑)
# ---------------------------------------------------------------
# 이 세 가지는 NEIS 에 API 가 없어, 학교 공식 홈페이지 게시판을 직접 스크래핑합니다.
# 오직 스크래핑 결과만 사용하며(샘플 DB 폴백 없음), 불러오지 못하면 빈 목록이 표시됩니다.
SCHOOL_NOTICE_URL=https://school.use.go.kr/cheonsang-h/M010301
SCHOOL_LETTER_URL=https://school.use.go.kr/cheonsang-h/M0104
SCHOOL_ALBUM_URL=https://school.use.go.kr/cheonsang-h/M01030401/list
SCHOOL_BASE_URL=https://school.use.go.kr
#
# ⚠️ 학교 홈페이지는 웹 방화벽에서 "해외 IP"를 차단합니다.
#    - v0 미리보기 / 해외 리전(Vercel US 등): 스크래핑이 차단되어 "표시할 항목이 없습니다"가 뜹니다(정상).
#    - 한국 IP(국내 서버) 에서 실행하면 실제 게시판 데이터가 수집됩니다.
#    ※ 위 게시판 URL 은 예시 기본값이니, 실제 메뉴 주소로 맞춰 주세요.
#
# (선택) 한국에 있는 프록시를 두면 해외 환경에서도 우회 수집이 가능합니다.
# 지정 시 목록 URL 앞에 붙여 요청합니다. 예) https://내프록시/fetch?url=
# SCHOOL_PROXY_BASE=
